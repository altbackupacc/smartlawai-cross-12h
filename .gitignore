# M1 data foundation -- large and/or fully regenerable from data/*.py + frozen splits
data/raw/
# Exclude contents, not the directory itself -- git never looks inside a
# wholesale-excluded directory, so a negation for one file inside it (below)
# would otherwise silently have no effect.
data/processed/*
!data/processed/near_duplicate_pairs.json
data/ocr_wer_gold/pages/
# Raw downloaded source PDFs for the OCR-WER gold-set prep tooling --
# regenerable via data/pilot/download_ocr_source_pdfs*.py, large binary data.
data/pilot/ocr_raw_pdfs/
data/pilot/ocr_raw_pdfs_hc/
