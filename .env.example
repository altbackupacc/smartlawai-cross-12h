# ----- Backend selection -----
# local  -> DuckDB + local filesystem + local FAISS  (VSCode / Kaggle dev)
# gcloud -> Cloud SQL Postgres + GCS + GCS FAISS      (production)
SMARTLAW_BACKEND=local
SMARTLAW_LOCAL_DIR=./.smartlaw_local

# ----- Mistral LLM endpoint (OpenAI-compatible: Ollama / vLLM / Cloud Run GPU) -----
MISTRAL_BASE_URL=http://localhost:11434/v1
MISTRAL_MODEL=mistral:7b-instruct
MISTRAL_API_KEY=not-needed

# ----- GCloud (only needed when SMARTLAW_BACKEND=gcloud) -----
GCS_BUCKET=smartlawai-docs
GCP_PROJECT=
REGION=us-central1
# Postgres connection (Cloud SQL)
PG_HOST=
PG_PORT=5432
PG_DB=smartlawai
PG_USER=
PG_PASSWORD=
# Path to service-account JSON for GCS (or use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# ----- Hugging Face (for fine-tuning / gated Mistral) -----
HF_TOKEN=
HF_HUB_ORG=smartlawai

# ----- M7 baselines -----
# SaulLM-7B endpoint (OpenAI-compatible vLLM, same shape as Mistral's above)
SAULLM_BASE_URL=http://localhost:11435/v1
SAULLM_API_KEY=not-needed
# Frontier model (Anthropic) -- only used by baselines/frontier_client.py,
# never by the serving pipeline. Required at call time, no silent default.
FRONTIER_PROVIDER=anthropic
FRONTIER_MODEL=
ANTHROPIC_API_KEY=
