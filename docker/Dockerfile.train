# Training image for Vertex AI Custom Jobs (gcloud/train_l4.sh, gcloud/train_a100.sh).
FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime

WORKDIR /app

# src/ must be copied before `pip install -e .` -- an editable install reads the
# actual source tree to build its own package metadata (egg_base/setuptools), so
# copying only pyproject.toml first (a layer-caching habit that works fine for a
# plain `pip install -r requirements.txt`) fails here with "'src' does not exist".
COPY pyproject.toml ./
COPY src/ ./src/
COPY train/ ./train/
RUN pip install --no-cache-dir -e ".[ml,train]"
# checkpointing.py's cloud sync isn't in any current extras group -- installed explicitly:
RUN pip install --no-cache-dir huggingface_hub "google-cloud-storage>=2.16"

ENV PYTHONPATH=/app/src:/app

# gcloud/train_l4.sh and train_a100.sh pass the target module as the first --args
# entry, e.g. "train.qlora.train_qlora,--seed=42,...", so this becomes:
#   python -m train.qlora.train_qlora --seed=42 --arm=C --device=cuda ...
ENTRYPOINT ["python", "-m"]
